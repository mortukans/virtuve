# Copy to .env and fill in. EXPO_PUBLIC_* are inlined into the app at build time.

# Supabase project (EU / Paris). Publishable (anon) key is safe to ship.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Universal link host for household invites (GitHub Pages or custom domain).
EXPO_PUBLIC_UNIVERSAL_LINK_HOST=virtuve.lv

# EAS / build (optional locally; set in CI).
EAS_PROJECT_ID=

# ─── Server-side only (Supabase Edge Function secrets, NEVER EXPO_PUBLIC) ───
# Set with: supabase secrets set KEY=value
# ANTHROPIC_API_KEY=sk-ant-...           # Claude: fridge vision + recipe generation
# ANTHROPIC_MODEL=claude-fable-5-1        # text/vision model id
# IMAGE_API_URL=https://api.openai.com/v1/images/generations  # optional AI meal previews
# IMAGE_API_KEY=                          # optional; empty → app falls back to typographic cards
# IMAGE_MODEL=gpt-image-1
