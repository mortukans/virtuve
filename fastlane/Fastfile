# Build Virtuve on a GitHub macOS runner and upload to TestFlight — no Apple ID
# password anywhere, only an App Store Connect API key. The Xcode project is
# generated by `npx expo prebuild` before this runs. Mirrors the Uzmini Cenu
# pipeline; the Apple account secrets (ASC_*, DIST_CERT_*) are reusable across apps.

require "date"
require "base64"

default_platform(:ios)

APP_ID    = "lv.virtuve.app"
APP_NAME  = "Virtuve"
XCODEPROJ = "ios/Virtuve.xcodeproj"
WORKSPACE = "ios/Virtuve.xcworkspace"
SCHEME    = "Virtuve"

platform :ios do
  desc "Build a signed App Store IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false,
    )

    setup_ci

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_ID }).find { |b| b.identifier == APP_ID }
    unless bundle
      UI.message("Registering bundle id #{APP_ID}")
      bundle = Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "IOS", identifier: APP_ID)
    end
    existing_caps = bundle.get_capabilities.map(&:capability_type)
    cap_settings = {
      "PUSH_NOTIFICATIONS" => [],
      "ASSOCIATED_DOMAINS" => [],
      "APPLE_ID_AUTH" => [{ key: "APPLE_ID_AUTH_APP_CONSENT", options: [{ key: "PRIMARY_APP_CONSENT" }] }],
    }
    cap_settings.each do |cap, settings|
      next if existing_caps.include?(cap)
      UI.message("Enabling #{cap}")
      bundle.create_capability(cap, settings: settings)
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No App Store Connect app for #{APP_ID}. Create it in App Store Connect → My Apps → + (bundle id #{APP_ID}).") unless app
    UI.success("App record ready: #{app.name} (#{app.id})")

    # Distribution certificate — reused via the DIST_CERT_P12 secret (account-wide).
    if ENV["DIST_CERT_P12"].to_s.strip.empty?
      today_plus_year = (Date.today >> 12)
      Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" }).each do |c|
        exp = Date.parse(c.expiration_date) rescue nil
        next unless exp && (exp - today_plus_year).abs <= 1
        UI.important("Revoking throwaway CI certificate #{c.id} (expires #{exp})")
        c.delete!
      end
      cert(api_key: api_key, team_id: ENV.fetch("APPLE_TEAM_ID"), generate_apple_certs: true, force: true,
           output_path: "fastlane/certs",
           keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"), keychain_password: "")
      UI.important("Exported fastlane/certs/*.p12 — base64 it into DIST_CERT_P12 so future runs reuse it")
    else
      p12 = File.expand_path("dist.p12")
      File.binwrite(p12, Base64.decode64(ENV["DIST_CERT_P12"]))
      import_certificate(certificate_path: p12, certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
                         keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"), keychain_password: "")
    end

    sigh(api_key: api_key, app_identifier: APP_ID, team_id: ENV.fetch("APPLE_TEAM_ID"), force: true,
         skip_certificate_verification: true, cert_id: ENV["DIST_CERT_ID"])

    update_code_signing_settings(
      path: XCODEPROJ, use_automatic_signing: false, team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution", profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: APP_ID, targets: [SCHEME],
    )

    increment_build_number(xcodeproj: XCODEPROJ, build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M")))

    gym(
      workspace: WORKSPACE, scheme: SCHEME, configuration: "Release", export_method: "app-store",
      clean: true, output_directory: "build", output_name: "Virtuve.ipa", xcargs: "-allowProvisioningUpdates",
      export_options: { provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] } },
    )

    pilot(
      api_key: api_key, ipa: "build/Virtuve.ipa", skip_waiting_for_build_processing: true,
      distribute_external: false, changelog: "Automated build #{ENV['BUILD_NUMBER']}",
    )
  end
end
